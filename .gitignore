.DS_Store
node_modules/

# Auth app build inputs. The OUTPUT (`/access/`) is committed on purpose — see
# auth-app/README.md: Pages serves this repo from the branch root with no CI
# step, so the built files have to be in the tree to be served.
auth-app/node_modules/
auth-app/.vite/
auth-app/node_modules/.vite/

# Throwaway verification harness. It mounts the real pages against a local
# PostgREST-shaped shim so the console can be driven without a live session;
# it is not part of the app and Vite only bundles index.html anyway. Kept out
# of the tree because a committed harness invites someone to treat it as a
# supported entry point.
auth-app/harness.html
auth-app/src/__harness__/

# Live credentials — the file says it is git-ignored, so make that true.
API_Gateway.md

# Sourcing tool: secrets and local candidate database
sourcing/.env
sourcing/data/
