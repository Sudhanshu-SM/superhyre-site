{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    /* "node" is required because vite.config.ts is in `include` and now imports
       node:fs / node:path / node:url for the dev asset middleware. With only
       vite/client listed, an explicit `types` array suppresses @types/node
       entirely and the config fails to type-check even though the package is
       installed. */
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
